generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Path {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  description     String   @default("")
  icon            String   @default("📘")
  order           Int      @default(0)
  isActive        Boolean  @default(true)
  color           String   @default("#3b9eff")
  estimatedHours  Float    @default(0)
  targetAudience  String   @default("All learners")
  difficulty      String   @default("foundational")
  modules         Module[]
  selections      PathSelection[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Module {
  id          String   @id @default(cuid())
  pathId      String
  title       String
  slug        String
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  description String   @default("")
  color       String   @default("")

  path        Path     @relation(fields: [pathId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@unique([pathId, slug])
}

model Lesson {
  id                 String   @id @default(cuid())
  moduleId           String
  title              String
  slug               String
  order              Int      @default(0)
  xpReward           Int      @default(10)
  type               String   @default("learn")
  isActive           Boolean  @default(true)
  lessonType         String   @default("learn")
  estimatedMinutes   Int      @default(5)
  learningObjectives String   @default("[]")
  difficulty         String   @default("foundational")

  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  cards     Card[]
  progress  Progress[]
  visits    LessonVisit[]
  attempts  LessonAttempt[]
  reviews LessonReview[]

  @@unique([moduleId, slug])
}

model Card {
  id          String    @id @default(cuid())
  lessonId    String
  type        String
  order       Int       @default(0)

  prompt      String
  body        String?
  mediaUrl    String?

  choicesJson String?
  answerJson  String?
  explain     String?

  subtype     String    @default("")
  difficulty  String    @default("foundational")
  tags        String    @default("[]")
  hint        String?

  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model User {
  id            String   @id @default(cuid())
  guestId       String?  @unique
  email         String?  @unique
  passwordHash  String?
  fullName      String?
  dateOfBirth   String?
  phone         String?
  city          String?
  state         String?
  zipCode       String?
  caseNumber    String?
  emergencyContactName  String?
  emergencyContactPhone String?
  isActive      Boolean  @default(true)
  hearts        Int      @default(5)
  totalXp       Int      @default(0)
  streak        Int      @default(0)
  streakFreezes Int      @default(1)
  lastFreezeUsedAt DateTime?
  lastActiveAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  consentGiven  Boolean  @default(false)
  consentAt     DateTime?
  earnedBadges  String   @default("[]")
  onboardingState String?
  learningGoal    String?
  dailyGoal       Int?
  learningTimezone String?
  lastLearningAt DateTime?
  lessonAttempts LessonAttempt[]
  lessonReviews LessonReview[]
  pathSelections  PathSelection[]
  lessonVisits    LessonVisit[]
  sessions      LearnerSession[]
  progress      Progress[]
  payoutRequests PayoutRequest[]
  rewardAccount RewardAccount?
  rewardEntries RewardEntry[]
  consents      ConsentRecord[]
  cases         Case[]
}

model LearnerSession {
  tokenHash String   @id
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Preferences organize learning; they never grant or remove curriculum access.
model PathSelection {
  userId String
  pathId String
  selectedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  path Path @relation(fields: [pathId], references: [id], onDelete: Cascade)
  @@id([userId, pathId])
}

// Opening a lesson records no answer, score, completion or XP award.
model LessonVisit {
  userId String
  lessonId String
  openedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  @@id([userId, lessonId])
  @@index([userId, openedAt])
}

model Progress {
  id               String   @id @default(cuid())
  userId           String
  lessonId         String
  completedAt      DateTime @default(now())
  xpEarned         Int      @default(0)
  crownLevel       Int      @default(1)
  score            Int?
  timeSpentSeconds Int      @default(0)
  reflectionAnswer String?
  missedCardIds    String   @default("[]")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

enum PaymentMethod {
  zelle
  venmo
  paypal
  cashapp
  check
}

model PayoutRequest {
  id            String         @id @default(cuid())
  userId        String
  xpAmount      Int
  dollarAmount  Float
  amountCents Int?
  rulesSnapshot String?
  requestKey String?
  payloadHash String?
  paymentReference String?
  paidAt DateTime?
  paidById String?
  rewardEntries RewardEntry[]
  paidBy AdminUser? @relation("PayoutPayer", fields: [paidById], references: [id])
  @@unique([userId, requestKey])
  @@unique([paymentMethod, paymentReference])
  status        String         @default("pending")
  note          String?
  paymentMethod PaymentMethod?
  paymentHandle String?
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  approvedById  String?
  approvedAt    DateTime?
  decisionNote  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy    AdminUser?   @relation("PayoutReviewer", fields: [reviewedById], references: [id])
  approvedBy    AdminUser?   @relation("PayoutApprover", fields: [approvedById], references: [id])
}

model AdminUser {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  fullName        String
  role            String    @default("caseworker")
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  lastLoginAt     DateTime?
  loginFailures   Int       @default(0)
  lockedUntil     DateTime?

  paidPayouts PayoutRequest[] @relation("PayoutPayer")
  rewardEntries RewardEntry[]
  reviewedPayouts  PayoutRequest[]    @relation("PayoutReviewer")
  approvedPayouts  PayoutRequest[]    @relation("PayoutApprover")
  auditLogs        AuditLog[]
  sessions         AdminSession[]
  assignedCases    Case[]             @relation("CaseAssignee")
  caseNotes        CaseNote[]
  resourceAllocations ResourceAllocation[]
  poolAdjustments  PoolAdjustment[]
}

model Case {
  id           String   @id @default(cuid())
  userId       String
  status       String   @default("new")
  priority     String   @default("medium")
  title        String
  message      String
  assignedToId String?
  location     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTo   AdminUser? @relation("CaseAssignee", fields: [assignedToId], references: [id])
  notes        CaseNote[]
  allocations  ResourceAllocation[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model CaseNote {
  id        String   @id @default(cuid())
  caseId    String
  adminId   String
  text      String
  type      String   @default("note")
  createdAt DateTime @default(now())

  case      Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  admin     AdminUser @relation(fields: [adminId], references: [id])

  @@index([caseId])
}

model ResourceAllocation {
  id           String   @id @default(cuid())
  caseId       String
  adminId      String
  resourceType String
  quantity     Int      @default(1)
  notes        String?
  createdAt    DateTime @default(now())

  case         Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  admin        AdminUser @relation(fields: [adminId], references: [id])

  @@index([caseId])
}

model ServiceDirectory {
  id        String   @id @default(cuid())
  name      String
  category  String
  address   String?
  phone     String?
  hours     String?
  notes     String?
  website   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

model AdminSession {
  id        String   @id @default(cuid())
  token     String   @unique
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([adminId])
}

model AuditLog {
  id          String   @id @default(cuid())
  adminId     String?
  action      String
  entity      String
  entityId    String?
  details     String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  admin       AdminUser? @relation(fields: [adminId], references: [id])

  @@index([entity, entityId])
  @@index([adminId])
  @@index([createdAt])
}

model ConsentRecord {
  id          String   @id @default(cuid())
  userId      String
  consentType String
  version     String   @default("1.0")
  granted     Boolean  @default(true)
  ipAddress   String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PayoutConfig {
  id            String   @id @default(cuid())
  programSlug   String   @unique
  programName   String
  xpToDollar    Float    @default(0.05)
  rateExact String?
  version Int @default(1)
  paymentMethods String?
  separateApprover Boolean @default(false)
  minimumXp     Int      @default(20)
  weeklyXpCap   Int      @default(500)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PoolBalance {
  id          String   @id @default(cuid())
  balanceCents Int     @default(0)
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model PoolAdjustment {
  requestKey String? @unique
  payoutId String? @unique
  id          String   @id @default(cuid())
  adminId     String
  amountCents Int
  reason      String
  createdAt   DateTime @default(now())

  admin       AdminUser @relation(fields: [adminId], references: [id])

  @@index([createdAt])
}

// Choice evidence and acknowledgements only. Personal reflection text is never stored here.
model LessonAttempt {
 id String @id @default(cuid())
 userId String
 lessonId String
 mode String
 contentHash String
 position Int @default(0)
 createdAt DateTime @default(now())
 completedAt DateTime?
 resultJson String?
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
 answers LessonAnswer[]
 @@index([userId, lessonId, createdAt])
}
model LessonAnswer {
 attemptId String
 cardId String
 ordinal Int
 choice Int?
 correct Boolean?
 skipped Boolean @default(false)
 answeredAt DateTime @default(now())
 attempt LessonAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
 @@id([attemptId, cardId])
 @@unique([attemptId, ordinal])
}
model LessonReview {
 userId String
 lessonId String
 successes Int @default(0)
 missedCardIds String @default("[]")
 dueAt DateTime
 lastReviewedAt DateTime
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
 @@id([userId, lessonId])
 @@index([userId, dueAt])
}

// Lifetime credit = available + reserved + spent. User.totalXp remains lifetime learning XP.
model RewardAccount {
 userId String @id
 learningXp Int @default(0)
 programSlug String?
 creditedXp Int
 availableXp Int
 reservedXp Int @default(0)
 spentXp Int @default(0)
 openingAdjustmentXp Int @default(0)
 createdAt DateTime @default(now())
 user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}
// Append-only evidence. Source key makes credits, reservations and decisions idempotent.
model RewardEntry {
 id String @id @default(cuid())
 userId String
 sourceKey String
 kind String
 payoutId String?
 adminId String?
 availableDelta Int @default(0)
 reservedDelta Int @default(0)
 spentDelta Int @default(0)
 creditedDelta Int @default(0)
 amountCents Int?
 fromStatus String?
 toStatus String?
 metadata String @default("{}")
 createdAt DateTime @default(now())
 user User @relation(fields: [userId], references: [id], onDelete: Restrict)
 payout PayoutRequest? @relation(fields: [payoutId], references: [id], onDelete: Restrict)
 admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: Restrict)
 @@unique([userId, sourceKey])
 @@index([payoutId, createdAt])
}
