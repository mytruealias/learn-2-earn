# Local PostgreSQL maintenance connection for CREATE DATABASE/ROLE only.
# The harness never uses DATABASE_URL or a pre-existing app/test DB as a reset target.
# Replace placeholders privately; use a local disposable PostgreSQL instance.
TEST_DATABASE_ADMIN_URL=postgresql://test_admin:replace-me@127.0.0.1:5432/postgres
# Optional preinstalled browser; otherwise install the bundled Playwright Chromium.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/bin/chromium
