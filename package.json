{
  "name": "learn-2-earn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5000 -H 0.0.0.0",
    "build": "npm run prisma:generate && tsx scripts/build.ts",
    "start": "next start -p 5000 -H 0.0.0.0",
    "lint": "eslint",
    "test": "npm run test:unit && npm run test:api && npm run test:e2e && npm run test:browser && npm run test:design && npm run test:journey && npm run test:progression && npm run test:lesson && npm run test:rewards",
    "test:api": "tsx scripts/run-tests.ts api",
    "test:api:watch": "tsx scripts/run-tests.ts api-watch",
    "test:e2e": "tsx scripts/run-tests.ts http",
    "test:e2e:ui": "tsx scripts/run-tests.ts legacy",
    "test:all": "npm test && npm run test:e2e:ui",
    "prisma:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:browser": "tsx scripts/run-tests.ts browser",
    "release:migrate": "tsx scripts/release.ts migrate",
    "release:content": "tsx scripts/release.ts content-sync",
    "release:bootstrap-admin": "tsx scripts/release.ts bootstrap-admin",
    "db:prepare-dev": "tsx scripts/release.ts prepare-dev",
    "recovery:inspect": "tsx prisma/fix-migration.ts",
    "test:design": "tsx scripts/run-tests.ts design",
    "test:journey": "tsx scripts/run-tests.ts journey",
    "test:progression": "tsx scripts/run-tests.ts progression",
    "test:lesson": "tsx scripts/run-tests.ts lesson",
    "audit:cards": "tsx scripts/audit-lesson-cards.ts",
    "rewards:reconcile": "tsx scripts/reconcile-rewards.ts",
    "test:rewards": "tsx scripts/run-tests.ts rewards"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.0",
    "@playwright/test": "^1.58.2",
    "@prisma/client": "6.1.0",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "next": "^15.5.15",
    "openai": "^6.33.0",
    "prisma": "6.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "stripe": "^21.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^15.5.15",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "minimatch@3": "3.1.4",
    "minimatch@9": "9.0.7",
    "flatted": "3.4.2",
    "picomatch@2": "2.3.2",
    "picomatch@4": "4.0.4"
  }
}
