# Local application settings only. Fill securely; never commit a filled .env.
DATABASE_URL=
SESSION_SECRET=
DEMO_ACCESS_CODE=
AUSTIN_ACCESS_PIN=
CITY_ACCESS_PIN=
# Optional host/metadata configuration; leave ROOT_DOMAIN unset for local/Replit preview.
ROOT_DOMAIN=
# NEXT_PUBLIC_SITE_URL=
ALLOWED_DEV_ORIGINS=
# Optional integrations. Never needed for build or isolated test suites.
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
# One-time explicit first-admin bootstrap only. Remove afterward.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_DEFAULT_PASSWORD=

# Optional learning-day fallback; saved learner timezone takes priority.
PROGRAM_TIMEZONE=UTC

# Staff authenticator encryption: supply privately via the runtime secret manager.
# 32 random bytes encoded as 64 hex characters; never a demo/invitation code.
STAFF_MFA_ENCRYPTION_KEY=
# STAFF_PROVISION_PASSWORD / STAFF_RECOVERY_PASSWORD are temporary explicit operator operations only.

# Optional Hubert AI: leave off until qualified human review and provider/host privacy verification.
# Exact reviewed policy version and external controlled review-record reference; never synthetic approval.
HUBERT_APPROVED_POLICY_VERSION=
HUBERT_REVIEW_REFERENCE=
# Optional cloud voice daily character limit (per account, fixed UTC day).
# TTS_DAILY_CHAR_CAP=20000

# Optional public partner inquiry: default off until migration, staffing/privacy/retention review.
# Stored scoped queue only; no email or calendar booking is sent.
PARTNER_INQUIRY_PROGRAM_ID=
PARTNER_INQUIRY_TEAM_NAME=
PARTNER_INQUIRY_MONITORING_NOTICE=
PARTNER_INQUIRY_REVIEW_REFERENCE=
